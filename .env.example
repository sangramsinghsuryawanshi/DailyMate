# Copy to .env and replace the placeholder values; .env is ignored by Git.
MYSQL_DATABASE=dailymate
MYSQL_USER=dailymate
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
MYSQL_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/dailymate?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=dailymate
DB_PASSWORD=replace-with-a-strong-password
# Base64-encoded random value of at least 32 bytes.
APP_JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
